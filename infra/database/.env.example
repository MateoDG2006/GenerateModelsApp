# Copie a infra/database/.env y cambie todas las claves. No versione el .env.
# Use claves sin caracteres reservados de URL (@ : / ? # %), porque se copian
# dentro de las URL de PostgreSQL del .env de la raíz.

POSTGRES_DB=ortesislab_dev
POSTGRES_USER=ortesislab_admin
POSTGRES_PASSWORD=cambie-admin

ORTESISLAB_MIGRATOR_PASSWORD=cambie-migrador
ORTESISLAB_APP_PASSWORD=cambie-app
ORTESISLAB_WORKER_PASSWORD=cambie-trabajador
ORTESISLAB_BACKUP_PASSWORD=cambie-backup

# MinIO. MINIO_IMAGE y MC_IMAGE permiten apuntar a otro registro de MinIO.
MINIO_ROOT_USER=ortesislab-root
MINIO_ROOT_PASSWORD=cambie-root-minio
ORTESISLAB_S3_ACCESS_KEY=ortesislab-app
ORTESISLAB_S3_SECRET_KEY=cambie-secreto-s3
ORTESISLAB_S3_BUCKET=ortesislab
ORTESISLAB_S3_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000
# MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
# MC_IMAGE=minio/mc:RELEASE.2025-08-13T08-35-41Z

ORTESISLAB_REDIS_MAXMEMORY=256mb
