# Configuración del backend Reflex y del trabajador. Copie a .env (no versionado)
# y use las mismas claves que infra/database/.env.
# Cada clave está declarada en web/Ajustes.py; las que no tienen defecto allí son
# obligatorias para el proceso que las lee.

# PostgreSQL: la web usa ortesislab_app y el trabajador ortesislab_worker.
ORTESISLAB_DATABASE_URL=postgresql+psycopg://ortesislab_app:cambie-app@127.0.0.1:5433/ortesislab_dev
ORTESISLAB_WORKER_DATABASE_URL=postgresql+psycopg://ortesislab_worker:cambie-trabajador@127.0.0.1:5433/ortesislab_dev

# Bucket S3 (MinIO). ORTESISLAB_S3_PUBLIC_URL es la base de object_url que abre el navegador.
ORTESISLAB_S3_ENDPOINT=http://127.0.0.1:9000
ORTESISLAB_S3_PUBLIC_URL=http://127.0.0.1:9000
ORTESISLAB_S3_ACCESS_KEY=ortesislab-app
ORTESISLAB_S3_SECRET_KEY=cambie-secreto-s3
ORTESISLAB_S3_BUCKET=ortesislab
ORTESISLAB_S3_REGION=us-east-1

# Caché de superficies. Si Redis no responde, la generación sigue sin caché.
ORTESISLAB_REDIS_URL=redis://127.0.0.1:6379/0

# OIDC. Con `make auth-dev-up` el proveedor de pruebas acepta cualquier cliente.
ORTESISLAB_OIDC_ISSUER=http://localhost:8080/default
ORTESISLAB_OIDC_CLIENT_ID=ortesislab-dev
ORTESISLAB_OIDC_CLIENT_SECRET=cambie-secreto-oidc
ORTESISLAB_OIDC_REDIRECT_URI=http://localhost:8000/auth/callback
ORTESISLAB_SESSION_SECRET=cambie-por-32-bytes-aleatorios
ORTESISLAB_APP_URL=http://localhost:3000
ORTESISLAB_COOKIE_SECURE=false

# Pruebas de propiedad contra la base desechable creada con `make db-test-reset`.
ORTESISLAB_TEST_DATABASE_URL=postgresql+psycopg://ortesislab_app:cambie-app@127.0.0.1:5433/ortesislab_test
ORTESISLAB_TEST_WORKER_DATABASE_URL=postgresql+psycopg://ortesislab_worker:cambie-trabajador@127.0.0.1:5433/ortesislab_test

# Alembic (db/alembic/env.py): el rol migrador es dueño del esquema ortesislab.
# La variante TEST se usa con `alembic -x base=test ...`.
ORTESISLAB_MIGRATOR_DATABASE_URL=postgresql+psycopg://ortesislab_migrator:cambie-migrador@127.0.0.1:5433/ortesislab_dev
ORTESISLAB_TEST_MIGRATOR_DATABASE_URL=postgresql+psycopg://ortesislab_migrator:cambie-migrador@127.0.0.1:5433/ortesislab_test
